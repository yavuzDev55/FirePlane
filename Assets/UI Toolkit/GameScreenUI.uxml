<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MissionHUD.uss?fileID=7433441132597879392&amp;guid=1e72018907d308a4a82fb380202dbcfe&amp;type=3#MissionHUD" />
    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0);">
        <ui:VisualElement name="FireStateHUD" class="hud-card hud-card--fire" style="position: absolute; top: 12px; left: 22px; width: 28%; flex-shrink: 0; color: rgb(55, 55, 55); background-color: rgba(0, 0, 0, 0.39);">
            <ui:Label text="🔥 FIRE STATUS" class="hud-section-title" style="-unity-font-definition: url(&quot;project://database/Assets/Others/Fonts/Rubik/static/Rubik-Bold.ttf?fileID=12800000&amp;guid=1d429b4cb3ca9304ba7de130132966e9&amp;type=3#Rubik-Bold&quot;); font-size: 14px; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0);" />
            <ui:VisualElement class="hud-divider" />
            <ui:Label text="Label" name="FiringCellsLabel" class="hud-label hud-label--fire" style="-unity-font-definition: url(&quot;project://database/Assets/Others/Fonts/Rubik/static/Rubik-Bold.ttf?fileID=12800000&amp;guid=1d429b4cb3ca9304ba7de130132966e9&amp;type=3#Rubik-Bold&quot;);" />
            <ui:Label text="Label" name="AshCellsLabel" class="hud-label hud-label--ash" style="-unity-font-definition: url(&quot;project://database/Assets/Others/Fonts/Rubik/static/Rubik-Bold.ttf?fileID=12800000&amp;guid=1d429b4cb3ca9304ba7de130132966e9&amp;type=3#Rubik-Bold&quot;);" />
        </ui:VisualElement>
        <ui:VisualElement name="WaterTankHUD" class="hud-card" style="position: absolute; right: 2%; bottom: 2%; width: 28%; flex-shrink: 0; background-color: rgba(0, 0, 0, 0.39);">
            <ui:Label text="💧 WATER TANK" class="hud-section-title" style="-unity-font-definition: url(&quot;project://database/Assets/Others/Fonts/Rubik/static/Rubik-Bold.ttf?fileID=12800000&amp;guid=1d429b4cb3ca9304ba7de130132966e9&amp;type=3#Rubik-Bold&quot;); font-size: 14px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(255, 255, 255);" />
            <ui:VisualElement class="hud-divider" />
            <ui:Label text="Label" name="WaterTankLabel" class="hud-label hud-label--water" style="-unity-font-definition: url(&quot;project://database/Assets/Others/Fonts/Rubik/static/Rubik-Bold.ttf?fileID=12800000&amp;guid=1d429b4cb3ca9304ba7de130132966e9&amp;type=3#Rubik-Bold&quot;);" />
            <ui:VisualElement name="BarBackground" style="width: 100%; height: 22px; background-color: rgba(20, 20, 50, 0.85); border-top-left-radius: 11px; border-top-right-radius: 11px; border-bottom-right-radius: 11px; border-bottom-left-radius: 11px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgba(0, 138, 205, 0.5); border-right-color: rgba(0, 138, 205, 0.5); border-bottom-color: rgba(0, 138, 205, 0.5); border-left-color: rgba(0, 138, 205, 0.5); overflow: hidden;">
                <ui:VisualElement name="BarFill" style="flex-grow: 1; height: 100%; width: 100%; background-color: rgb(0, 138, 205); border-top-left-radius: 11px; border-top-right-radius: 11px; border-bottom-right-radius: 11px; border-bottom-left-radius: 11px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MissionHUD" class="mission-hud">
            <ui:VisualElement name="GroupCard" class="group-card" style="background-color: rgba(0, 0, 0, 0.39);">
                <ui:Label name="GroupNameLabel" class="group-name" />
                <ui:VisualElement name="Divider" class="divider" />
                <ui:VisualElement name="ObjectiveList" class="objective-list">
                    <ui:VisualElement name="ObjectiveRow" class="objective-row">
                        <ui:Label name="ObjectiveIcon" text="○" class="objective-icon" />
                        <ui:VisualElement name="ObjectiveInfo" class="objective-info">
                            <ui:Label name="ObjectiveDescription" class="objective-description" />
                            <ui:Label name="ObjectiveProgress" class="objective-progress" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
